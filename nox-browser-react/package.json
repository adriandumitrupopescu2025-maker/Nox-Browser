{
  "name": "nox-browser",
  "version": "1.0.2",
  "description": "Nox Browser - Hybrid Web Browser and Local File Manager",
  "author": {
    "name": "Adrian Popescu",
    "email": "adriandumitrupopescu.2025@gmail.com"
  },
  "homepage": "https://github.com/nox-browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb rpm",
    "build:deb": "electron-builder --linux deb",
    "build:rpm": "electron-builder --linux rpm",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nox.browser",
    "productName": "Nox Browser",
    "executableName": "nox-browser",
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "password-preload.js",
      "styles.css"
    ],
    "icon": "build/icon.png",
    "linux": {
      "icon": "build/icon.png",
      "maintainer": "Adrian Popescu <adrian@example.com>",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network",
      "artifactName": "Nox-Browser-${version}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Nox-Browser-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "cross-fetch": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}
